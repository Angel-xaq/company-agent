# ===== 数据库 =====
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/company_agent

# ===== JWT =====
JWT_SECRET_KEY=please-replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
# 生产环境使用 HTTPS 时改为 true
COOKIE_SECURE=false

# ===== 跨域 =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 大模型（OpenAI 兼容协议）=====
# 未配置 LLM_KEY 时，智能对话自动降级为指令模式
# 当前使用官方推荐的 deepseek-flash；如使用第三方代理，按服务商填写 BASE_URL
LLM_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# ===== Embedding =====
# local：使用 sentence-transformers 本地模型（需能访问 HuggingFace）
# openai：使用 OpenAI 兼容 embeddings 接口（如 SiliconFlow）
EMBEDDING_PROVIDER=openai
EMBEDDING_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== 向量库 =====
VECTOR_STORE=chroma
CHROMA_DIR=./data/chroma

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
KNOWLEDGE_MAX_MB=20

# ===== 会议室预约 =====
TIMEZONE=Asia/Shanghai
BUSINESS_START=09:30
BUSINESS_END=21:00
SLOT_MINUTES=30
BOOKING_MAX_HOURS=4
BOOKING_MAX_DAYS=30
BOOKING_MAX_PER_DAY=3
